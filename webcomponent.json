{
  "id": "com.sap.sac.exceluploaderpro",
  "version": "3.11.3",
  "name": "Excel Planning Uploader Pro",
  "description": "Multi-Sheet Consolidation, Transform & Convert, Alert Semaphores for SAC Planning",
  "newInstancePrefix": "ExcelUploaderPro_",
  "icon": "",
  "vendor": "Jose Enriquez SixSevenGroup",
  "eula": "",
  "license": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "custom-excel-uploader-pro",
      "url": "https://cdn.jsdelivr.net/gh/enriquezmou-oss/sac-excel-uploader@355e2ce/excel-uploader.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "validatedDataJson": {
      "type": "string",
      "default": ""
    },
    "currentUser": {
      "type": "string",
      "default": "SAP User (Planning)"
    },
    "sacModelId": {
      "type": "string",
      "default": "PLAN_CAPEX_PLANNING"
    },
    "sacTenantUrl": {
      "type": "string",
      "default": ""
    },
    "existingDataInfo": {
      "type": "string",
      "default": ""
    }
  },
  "methods": {
    "setExistingDataInfo": {
      "description": "Passes current Table_1 row values to the widget for client-side accumulation in Append mode",
      "parameters": [
        { "name": "dataJson", "type": "string" }
      ],
      "body": "this.existingDataInfo = dataJson;"
    }
  },
  "events": {
    "dataReady": {
      "description": "Triggered when the user clicks Synchronize on validated records"
    }
  }
}